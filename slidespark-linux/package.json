{
  "name": "slidespark",
  "version": "1.0.5",
  "description": "SlideSpark presentation editor for Linux desktops",
  "main": "main.cjs",
  "author": {
    "name": "MosSuite",
    "email": "moswebgr@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage deb rpm tar.gz pacman snap",
    "dist:linux:x64": "electron-builder --linux AppImage deb rpm tar.gz pacman snap --x64",
    "dist:linux:arm64": "electron-builder --linux AppImage deb rpm tar.gz pacman snap --arm64",
    "pre-dist:linux": "mkdir -p build && convert ../SlideSpark.png -filter Lanczos -resize 512x512 build/icon.png",
    "pre-dist:linux:x64": "mkdir -p build && convert ../SlideSpark.png -filter Lanczos -resize 512x512 build/icon.png",
    "pre-dist:linux:arm64": "mkdir -p build && convert ../SlideSpark.png -filter Lanczos -resize 512x512 build/icon.png"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "gr.mossuite.slidespark",
    "productName": "SlideSpark",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "app/**/*",
      "build/icon.png",
      "package.json"
    ],
    "linux": {
      "category": "Office",
      "icon": "build/icon.png"
    },
    "deb": {
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnss3"
      ],
      "maintainer": "MosSuite <moswebgr@users.noreply.github.com>"
    },
    "appImage": {},
    "snap": {
      "grade": "stable",
      "confinement": "strict",
      "summary": "Create and edit presentations",
      "description": "SlideSpark is a desktop presentation editor from MosSuite."
    },
    "artifactName": "SlideSpark-${version}-${arch}.${ext}",
    "rpm": {
      "depends": [
        "gtk3",
        "nss"
      ]
    },
    "pacman": {
      "depends": [
        "gtk3",
        "nss"
      ]
    }
  },
  "dependencies": {
    "pptxgenjs": "^3.12.0"
  },
  "homepage": "https://github.com/moswebgr/Office"
}
