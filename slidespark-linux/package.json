{
  "name": "slidespark-mossuite",
  "version": "1.0.0",
  "description": "SlideSpark presentation editor for Linux desktops",
  "main": "main.cjs",
  "author": {
    "name": "MosSuite",
    "email": "moswebgr@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage deb rpm tar.gz pacman",
    "dist:linux:x64": "electron-builder --linux AppImage deb rpm tar.gz pacman --x64",
    "dist:linux:arm64": "electron-builder --linux AppImage deb rpm tar.gz pacman --arm64",
    "pre-dist:linux": "mkdir -p build && cp ../SlideSpark.png build/icon.png",
    "pre-dist:linux:x64": "mkdir -p build && cp ../SlideSpark.png build/icon.png",
    "pre-dist:linux:arm64": "mkdir -p build && cp ../SlideSpark.png build/icon.png"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "gr.mossuite.slidespark",
    "productName": "SlideSpark",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "app/**/*",
      "build/icon.png",
      "package.json"
    ],
    "linux": {
      "category": "Office"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnss3"
      ],
      "maintainer": "MosSuite <moswebgr@users.noreply.github.com>"
    },
    "appImage": {},
    "artifactName": "SlideSpark-${version}-${arch}.${ext}",
    "icon": "build/icon.png",
    "rpm": {
      "depends": [
        "gtk3",
        "nss"
      ]
    },
    "pacman": {
      "depends": [
        "gtk3",
        "nss"
      ]
    }
  },
  "dependencies": {
    "pptxgenjs": "^3.12.0"
  },
  "homepage": "https://github.com/moswebgr/Office"
}
