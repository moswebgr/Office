{
  "name":"mossuite-launcher","version":"1.0.1","description":"MosSuite Linux desktop application launcher",
  "homepage":"https://moswebgr.github.io/Office","author":{"name":"MosSuite","email":"moswebgr@users.noreply.github.com"},
  "main":"main.cjs","license":"MIT","scripts":{"start":"electron .","dist":"electron-builder --linux AppImage deb rpm tar.gz"},
  "devDependencies":{"electron":"^35.0.0","electron-builder":"26.0.12"},
  "build":{"appId":"gr.mossuite.launcher","productName":"MosSuite","executableName":"mossuite","directories":{"output":"dist"},
    "files":["main.cjs","app/**/*","assets/**/*","package.json"],
    "linux":{"category":"Office","icon":"assets/icon.png","target":["AppImage","deb","rpm","tar.gz"],"maintainer":"MosSuite <moswebgr@users.noreply.github.com>"},
    "deb":{"depends":["libgtk-3-0 | libgtk-3-0t64","libnss3"]},"rpm":{"depends":["gtk3","nss"]},
    "artifactName":"MosSuite-Linux-${version}-${arch}.${ext}"
  }
}